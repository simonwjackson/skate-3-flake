     cursor_auto_hide_timer_ = 0;
@@ -684,7 +685,36 @@
 }
 
 void GTKWindow::RequestPaintImpl() {
-  gtk_widget_queue_draw(drawing_area_);
+  // RequestPaint permits non-UI callers, but GTK widget access does not.
+  // Match GTKWindowedAppContext's idle-source dispatch and coalesce requests.
+  std::lock_guard<std::mutex> lock(paint_source_mutex_);
+  if (!paint_source_) {
+    paint_source_ = gdk_threads_add_idle(PaintSourceFunc, this);
+  }
+}
+
+gboolean GTKWindow::PaintSourceFunc(gpointer data) {
+  auto& window = *static_cast<GTKWindow*>(data);
+  assert_true(window.app_context().IsInUIThread());
+  {
+    std::lock_guard<std::mutex> lock(window.paint_source_mutex_);
+    window.paint_source_ = 0;
+  }
+  if (window.drawing_area_) {
+    gtk_widget_queue_draw(window.drawing_area_);
+  }
+  return G_SOURCE_REMOVE;
+}
+
+void GTKWindow::CancelPendingPaint() {
+  // Called after surface disconnection has stopped non-UI paint requests.
+  // The callback also runs on this thread, so it cannot race destruction.
+  assert_true(app_context().IsInUIThread());
+  std::lock_guard<std::mutex> lock(paint_source_mutex_);
+  if (paint_source_) {
+    g_source_remove(paint_source_);
+    paint_source_ = 0;
+  }
 }
 
