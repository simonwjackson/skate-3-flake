+// A cvar counts as set when settings.toml contains it, or when it differs
+// from its default (for example from the command line). The file test
+// matters: a saved new value equal to the default must still win over a
+// deprecated key.
+bool CvarIsSet(const toml::table* settings, std::string_view name) {
+  return (settings != nullptr && settings->contains(name)) ||
+         rex::cvar::HasNonDefaultValue(name);
+}
+
+// Copies a deprecated cvar to its new name. The new name wins when both are
+// set.
+void MigrateDeprecatedCvar(const toml::table* settings, std::string_view old_name,
+                           std::string_view new_name, std::string_view value) {
+  if (!CvarIsSet(settings, old_name)) {
+    return;
+  }
+  if (CvarIsSet(settings, new_name)) {
+    REXLOG_WARN("{} is deprecated and ignored because {} is set; remove it", old_name,
+                new_name);
+    return;
+  }
+  REXLOG_WARN("{} is deprecated; use {}", old_name, new_name);
+  rex::cvar::SetFlagByName(new_name, value);
+}
+
+void MigrateDeprecatedDisplayCvars(const std::filesystem::path& settings_path) {
+  std::optional<toml::table> settings;
+  if (std::filesystem::exists(settings_path)) {
+    try {
+      settings = toml::parse_file(settings_path.string());
+    } catch (const toml::parse_error&) {
+      // LoadConfig already reported the file; fall back to the defaults test.
+    }
+  }
+  const toml::table* table = settings ? &*settings : nullptr;
+  MigrateDeprecatedCvar(table, "skate3_ultrawide", "skate3_match_display",
+                        REXCVAR_GET(skate3_ultrawide) ? "true" : "false");
+  MigrateDeprecatedCvar(table, "skate3_ultrawide_target_aspect", "skate3_display_aspect",
+                        std::to_string(REXCVAR_GET(skate3_ultrawide_target_aspect)));
+  MigrateDeprecatedCvar(table, "skate3_ultrawide_widen_game_frustum",
+                        "skate3_widen_game_frustum",
+                        REXCVAR_GET(skate3_ultrawide_widen_game_frustum) ? "true" : "false");
+}
